{
  "name": "opentune-macos",
  "productName": "OpenTune",
  "version": "1.1.0",
  "description": "OpenTune — Native macOS desktop client wrapping YouTube Music Web with Premium support",
  "main": "src/main.js",
  "author": "YTM Native Studio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg --universal",
    "dist:mac:arm64": "electron-builder --mac dmg --arm64",
    "dist:mac:x64": "electron-builder --mac dmg --x64",
    "dist:mac:universal": "electron-builder --mac dmg --universal"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}